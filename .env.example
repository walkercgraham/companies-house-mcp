# Required. Free key from developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# live (default), replay (use saved test data), record (live + save test data)
CH_TRANSPORT_MODE=live

# stdio (default, for Claude Desktop/Code) or http (hosted)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
# Required when MCP_TRANSPORT=http
MCP_HTTP_TOKEN=

# Companies House allows 600 requests per 5 minutes
CH_RATE_LIMIT_PER_5MIN=600
LOG_LEVEL=INFO

# Only needed to run the evals
ANTHROPIC_API_KEY=
